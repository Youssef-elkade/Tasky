@model Tasky.Models.Board

<div id="taskDetailsOverlay" class="fixed inset-0 bg-black/20 z-40 hidden"></div>
<div id="taskDetailsPanel" class="fixed right-0 top-0 bottom-0 w-full max-w-sm sm:max-w-md bg-background border-l border-border shadow-xl z-50 flex flex-col overflow-hidden transition-transform translate-x-full">
    <div class="flex items-center justify-between px-5 py-4 border-b border-border shrink-0">
        <span class="text-sm font-medium text-muted-foreground">Task Details</span>
        <div class="flex items-center gap-1">
            <button id="tpDeleteBtn" class="p-1.5 rounded-lg text-muted-foreground hover:text-destructive hover:bg-destructive/10 transition-all">
                <i data-lucide="trash-2" class="w-4 h-4"></i>
            </button>
            <button id="tpCloseBtn" class="p-1.5 rounded-lg text-muted-foreground hover:text-foreground hover:bg-muted transition-all">
                <i data-lucide="x" class="w-4 h-4"></i>
            </button>
        </div>
    </div>

    <div class="flex-1 overflow-y-auto p-5 space-y-6">
        <input type="hidden" id="tpTaskId" />
        
        <div>
            <input id="tpTitle" placeholder="Task title" class="w-full text-xl font-bold text-foreground bg-transparent outline-none border-none placeholder:text-muted-foreground/50 resize-none leading-tight" />
        </div>

        <div class="space-y-2">
            <p class="text-xs font-semibold text-muted-foreground uppercase tracking-wider">Status</p>
            <div class="flex flex-wrap gap-1.5">
                <button class="tp-status-btn px-3 py-1.5 rounded-lg text-sm font-medium border transition-all bg-muted text-muted-foreground" data-status="todo">To Do</button>
                <button class="tp-status-btn px-3 py-1.5 rounded-lg text-sm font-medium border transition-all bg-blue-100 text-blue-700 dark:bg-blue-900/30 dark:text-blue-400" data-status="in_progress">In Progress</button>
                <button class="tp-status-btn px-3 py-1.5 rounded-lg text-sm font-medium border transition-all bg-green-100 text-green-700 dark:bg-green-900/30 dark:text-green-400" data-status="done">Done</button>
                <button class="tp-status-btn px-3 py-1.5 rounded-lg text-sm font-medium border transition-all bg-red-100 text-red-700 dark:bg-red-900/30 dark:text-red-400" data-status="cancelled">Cancelled</button>
            </div>
        </div>

        <div class="space-y-2">
            <p class="text-xs font-semibold text-muted-foreground uppercase tracking-wider flex items-center gap-1">
                <i data-lucide="flag" class="w-3 h-3"></i> Priority
            </p>
            <div class="flex flex-wrap gap-1.5">
                <button class="tp-priority-btn px-3 py-1.5 rounded-lg text-sm font-medium border capitalize transition-all bg-slate-100 text-slate-600 border-slate-200 dark:bg-slate-800 dark:text-slate-300 dark:border-slate-700" data-priority="low">Low</button>
                <button class="tp-priority-btn px-3 py-1.5 rounded-lg text-sm font-medium border capitalize transition-all bg-blue-100 text-blue-700 border-blue-200 dark:bg-blue-900/40 dark:text-blue-300 dark:border-blue-800" data-priority="medium">Medium</button>
                <button class="tp-priority-btn px-3 py-1.5 rounded-lg text-sm font-medium border capitalize transition-all bg-orange-100 text-orange-700 border-orange-200 dark:bg-orange-900/40 dark:text-orange-300 dark:border-orange-800" data-priority="high">High</button>
                <button class="tp-priority-btn px-3 py-1.5 rounded-lg text-sm font-medium border capitalize transition-all bg-red-100 text-red-700 border-red-200 dark:bg-red-900/40 dark:text-red-300 dark:border-red-800" data-priority="urgent">Urgent</button>
            </div>
        </div>

        <div class="space-y-2">
            <p class="text-xs font-semibold text-muted-foreground uppercase tracking-wider flex items-center gap-1">
                <i data-lucide="calendar" class="w-3 h-3"></i> Due Date
            </p>
            <input type="date" id="tpDueDate" class="px-3 py-2 text-sm border border-input rounded-lg bg-background text-foreground outline-none focus:ring-2 ring-ring cursor-pointer" />
            <button id="tpClearDateBtn" class="text-xs text-muted-foreground hover:text-destructive transition-colors hidden ml-2">Clear date</button>
        </div>

        @if (Model != null && Model.IsCollective && Model.Members != null && Model.Members.Any())
        {
            <div class="space-y-2">
                <p class="text-xs font-semibold text-muted-foreground uppercase tracking-wider flex items-center gap-1">
                    <i data-lucide="users" class="w-3 h-3"></i> Assignees
                </p>
                <div id="tpAssigneesContainer" class="space-y-1">
                    @foreach (var member in Model.Members)
                    {
                        <button class="tp-assignee-btn w-full flex items-center gap-2.5 px-3 py-2 rounded-lg border transition-all text-left bg-card border-card-border text-muted-foreground hover:border-primary/30 hover:text-foreground" data-user-id="@member.UserId">
                            <div class="w-7 h-7 rounded-full bg-primary flex items-center justify-center shrink-0 overflow-hidden">
                                <span class="text-primary-foreground text-xs font-bold">@member.User?.UserName?.Substring(0, 1).ToUpper()</span>
                            </div>
                            <div class="flex-1 min-w-0">
                                <p class="text-sm font-medium truncate">@member.User?.UserName</p>
                                <p class="text-xs text-muted-foreground truncate">@member.User?.Email</p>
                            </div>
                            <i data-lucide="check" class="w-4 h-4 text-primary shrink-0 opacity-0 transition-opacity check-icon"></i>
                        </button>
                    }
                </div>
            </div>
        }

        <div class="space-y-2">
            <p class="text-xs font-semibold text-muted-foreground uppercase tracking-wider flex items-center gap-1">
                <i data-lucide="align-left" class="w-3 h-3"></i> Description
            </p>
            <textarea id="tpDescription" placeholder="Add a description..." rows="5" class="w-full text-sm text-foreground bg-muted/50 border border-input rounded-lg px-3 py-2 outline-none focus:ring-2 ring-ring resize-none placeholder:text-muted-foreground"></textarea>
        </div>
    </div>

    <div class="px-5 py-3 border-t border-border shrink-0 flex items-center justify-between">
        <span id="tpSaveStatus" class="text-xs text-muted-foreground">Changes saved automatically</span>
    </div>
</div>