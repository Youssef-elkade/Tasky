@model Tasky.Models.Note
@{
    var NOTE_COLORS = ViewData["Colors"] as string[];
    var bgColor = string.IsNullOrEmpty(Model.Color) ? "#6366f133" : Model.Color;
    var title = Model.Title ?? "";
    var content = Model.Content ?? "";
}

<div class="relative group/sortable note-card-container flex justify-center"
     data-note-id="@Model.Id"
     draggable="true"
     data-title="@title.ToLower()"
     data-content="@content.ToLower()">

    <div class="absolute top-1 left-1 z-10 cursor-grab active:cursor-grabbing opacity-0 group-hover/sortable:opacity-100 transition-opacity p-1 rounded bg-black/5 hover:bg-black/15 drag-handle"
         draggable="false">

        <i data-lucide="grip-vertical"
               class="w-3 h-3 text-gray-500">
        </i>

    </div>

    <div class="note-card rounded-xl p-4 border border-black/10 shadow-sm cursor-pointer flex flex-col gap-2 min-h-[100px] w-[200px] relative group"
         style="background-color: @bgColor"
         tabindex="0">

        <div class="note-view-mode flex flex-col gap-2 flex-1 pointer-events-none">

            @if (!string.IsNullOrEmpty(title))
            {
                <p class="text-sm font-semibold text-gray-800 truncate  dark:text-gray-200">
                    @title
                </p>
            }

            <p class="text-sm text-gray-700 whitespace-pre-wrap break-words flex-1  dark:text-gray-200">

                @if (!string.IsNullOrEmpty(content))
                {
                    @content
                }
                else
                {
                    @Html.Raw("<span class='text-gray-400 italic'>Empty note</span>")
                }

            </p>

        </div>

        <div class="note-edit-mode hidden flex-col gap-2 flex-1">

            <input type="text"
                   value="@title"
                   placeholder="Title"
                   class="note-title-input text-sm font-semibold bg-transparent border-b border-black/20 outline-none w-full text-gray-800 placeholder:text-gray-400  dark:text-gray-300" />

            <textarea placeholder="Take a note..."
                      class="note-content-input text-sm bg-transparent outline-none w-full text-gray-700 placeholder:text-gray-400 resize-none flex-1 min-h-[60px]  dark:text-gray-300"
                      rows="3">@content</textarea>

        </div>

        <div class="flex items-center justify-between opacity-0 group-hover:opacity-100 transition-opacity mt-1 note-actions">

            <div class="flex gap-1 flex-wrap">

                @foreach (var color in NOTE_COLORS)
                {
                    <button class="color-btn w-4 h-4 rounded-full border border-black/10 hover:scale-125 transition-transform @(bgColor == color ? "ring-2 ring-primary ring-offset-1" : "")"
                            style="background-color: @color"
                            data-color="@color">
                    </button>
                }

            </div>

            <div class="flex items-center gap-1 shrink-0">

                <button class="pin-btn p-1 rounded hover:bg-black/10 transition-colors"
                        data-pinned="@Model.IsPinned.ToString().ToLower()">

                    @if (Model.IsPinned)
                    {
                        <i data-lucide="pin-off"
                               class="w-3.5 h-3.5 text-gray-600">
                        </i>
                    }
                    else
                    {
                        <i data-lucide="pin"
                               class="w-3.5 h-3.5 text-gray-600">
                        </i>
                    }

                </button>

                <button class="delete-btn p-1 rounded hover:bg-red-100 transition-colors">

                    <i data-lucide="trash-2"
                           class="w-3.5 h-3.5 text-gray-600 hover:text-red-500">
                    </i>

                </button>

            </div>

        </div>

        @if (Model.IsPinned)
        {
            <div class="absolute top-2 right-2 pinned-icon">

                <i data-lucide="pin"
                       class="w-3 h-3 text-gray-500">
                </i>

            </div>
        }

    </div>

</div>