@model Tasky.Models.Board

<a asp-controller="Boards"
       asp-action="Details"
       asp-route-id="@Model.Id"
       class="block bg-card border border-card-border rounded-xl overflow-hidden hover:shadow-md hover:border-primary/30 transition-all cursor-pointer group">

    <div class="h-16 relative"
         style="background:@(string.IsNullOrWhiteSpace(Model.Color) ? "#6366f1" : Model.Color)">

        <div class="absolute top-2 right-2 flex gap-1">

            @if (Model.IsCollective)
            {
                <span class="bg-white/20 text-white text-xs px-2 py-0.5 rounded-full flex items-center gap-1">

                    <i data-lucide="users"
                           class="w-3 h-3">
                    </i>

                    Collective

                </span>
            }

        </div>

    </div>

    <div class="p-4">

        <h3 class="font-semibold text-card-foreground group-hover:text-primary transition-colors truncate">

            @(string.IsNullOrWhiteSpace(Model.Title)
                ? "Untitled"
                : Model.Title)

        </h3>

        @if (!string.IsNullOrWhiteSpace(Model.Description))
        {
            <p class="text-sm text-muted-foreground mt-1 line-clamp-2">

                @Model.Description

            </p>
        }

        <div class="flex items-center gap-3 mt-3 text-xs text-muted-foreground">

            <span>

                @(Model.Lists?.Sum(x => x.Tasks.Count) ?? 0) tasks

            </span>

            @if (Model.IsCollective)
            {
                <span class="flex items-center gap-1">

                    <i data-lucide="users"
                           class="w-3 h-3">
                    </i>

                    @(Model.Members?.Count ?? 0) members

                </span>
            }

        </div>

    </div>

</a>