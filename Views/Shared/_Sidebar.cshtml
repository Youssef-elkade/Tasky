@using Microsoft.AspNetCore.Identity
@using Tasky.Models

@inject UserManager<User> UserManager

@{
    var currentUser = await UserManager.GetUserAsync(User);

    var path = Context.Request.Path.Value?.ToLower() ?? "";
}

<div class="hidden md:block md:w-60 md:shrink-0">
</div>

<aside id="sidebar"
       class="fixed inset-y-0 left-0 w-60 z-50 flex flex-col bg-sidebar border-r border-sidebar-border transition-transform duration-300 ease-in-out md:translate-x-0 -translate-x-full">

    <div class="px-5 py-4 border-b border-sidebar-border flex items-center justify-between">

        <a asp-controller="Dashboard" asp-action="Index" class="flex items-center gap-2.5">

            <div class="flex items-center gap-3">
                <div class="relative w-10 h-10 rounded-2xl bg-primary flex items-center justify-center shadow-sm border border-border/40">
                    <span class="text-primary-foreground text-[22px] font-black font-serif leading-none -mt-[1px]">
                        T
                    </span>
                </div>
                <div class="flex flex-col leading-none">
                    <span class="font-extrabold text-[18px] tracking-tight text-sidebar-foreground">
                        Tasky
                    </span>
                </div>
            </div>
        </a>

        <button id="sidebarClose"
                class="md:hidden p-1 rounded-lg text-sidebar-foreground hover:bg-sidebar-accent transition-colors">

            <i data-lucide="x"
                   class="w-4 h-4">
            </i>

        </button>

    </div>

    <nav class="flex-1 px-3 py-3 space-y-0.5 overflow-y-auto">

        <a asp-controller="Dashboard"
               asp-action="Index"
               class="flex items-center gap-2.5 px-3 py-2 rounded-lg text-sm font-medium transition-all duration-150 @(path == "/" ? "bg-sidebar-primary text-sidebar-primary-foreground shadow-sm" : "text-sidebar-foreground hover:bg-sidebar-accent hover:text-sidebar-accent-foreground")">

            <i data-lucide="layout-dashboard"
                   class="w-4 h-4 shrink-0">
            </i>

            <span>Dashboard</span>

        </a>

        <a asp-controller="Boards"
               asp-action="Index"
               class="flex items-center gap-2.5 px-3 py-2 rounded-lg text-sm font-medium transition-all duration-150 @(path.StartsWith("/boards") ? "bg-sidebar-primary text-sidebar-primary-foreground shadow-sm" : "text-sidebar-foreground hover:bg-sidebar-accent hover:text-sidebar-accent-foreground")">

            <i data-lucide="square-kanban"
                   class="w-4 h-4 shrink-0">
            </i>

            <span>Boards</span>

        </a>

        <a asp-controller="Lists"
               asp-action="Index"
               class="flex items-center gap-2.5 px-3 py-2 rounded-lg text-sm font-medium transition-all duration-150 @(path.StartsWith("/lists") ? "bg-sidebar-primary text-sidebar-primary-foreground shadow-sm" : "text-sidebar-foreground hover:bg-sidebar-accent hover:text-sidebar-accent-foreground")">

            <i data-lucide="list"
                   class="w-4 h-4 shrink-0">
            </i>

            <span>Lists</span>

        </a>

        <a asp-controller="Tasks"
               asp-action="Index"
               class="flex items-center gap-2.5 px-3 py-2 rounded-lg text-sm font-medium transition-all duration-150 @(path.StartsWith("/tasks") ? "bg-sidebar-primary text-sidebar-primary-foreground shadow-sm" : "text-sidebar-foreground hover:bg-sidebar-accent hover:text-sidebar-accent-foreground")">

            <i data-lucide="square-check-big"
                   class="w-4 h-4 shrink-0">
            </i>

            <span>My Tasks</span>

        </a>

        <a asp-controller="Notes"
               asp-action="Index"
               class="flex items-center gap-2.5 px-3 py-2 rounded-lg text-sm font-medium transition-all duration-150 @(path.StartsWith("/notes") ? "bg-sidebar-primary text-sidebar-primary-foreground shadow-sm" : "text-sidebar-foreground hover:bg-sidebar-accent hover:text-sidebar-accent-foreground")">

            <i data-lucide="sticky-note"
                   class="w-4 h-4 shrink-0">
            </i>

            <span>Notes</span>

        </a>

        <a asp-controller="Canvases"
               asp-action="Index"
               class="flex items-center gap-2.5 px-3 py-2 rounded-lg text-sm font-medium transition-all duration-150 @(path.StartsWith("/canvases") ? "bg-sidebar-primary text-sidebar-primary-foreground shadow-sm" : "text-sidebar-foreground hover:bg-sidebar-accent hover:text-sidebar-accent-foreground")">

            <i data-lucide="book-open"
                   class="w-4 h-4 shrink-0">
            </i>

            <span>Canvases</span>

        </a>

    </nav>

    <div class="px-3 py-3 border-t border-sidebar-border space-y-0.5">

        <button id="themeToggle"
                class="w-full flex items-center gap-2.5 px-3 py-2 rounded-lg text-sm font-medium text-sidebar-foreground hover:bg-sidebar-accent transition-all">

            <i data-lucide="moon"
                   class="w-4 h-4 shrink-0 dark:hidden">
            </i>

            <i data-lucide="sun"
                   class="w-4 h-4 shrink-0 hidden dark:block">
            </i>

            <span class="dark:hidden">
                Dark mode
            </span>

            <span class="hidden dark:block">
                Light mode
            </span>

        </button>

        <a asp-controller="Settings"
               asp-action="Index"
               class="flex items-center gap-2.5 px-3 py-2 rounded-lg text-sm font-medium transition-all @(path.StartsWith("/settings") ? "bg-sidebar-primary text-sidebar-primary-foreground" : "text-sidebar-foreground hover:bg-sidebar-accent")">

            <i data-lucide="settings"
                   class="w-4 h-4">
            </i>

            <span>Settings</span>

        </a>

        @if (User.Identity!.IsAuthenticated && currentUser != null)
        {
            <a asp-controller="Users"
                   asp-action="Profile"
                   asp-route-id="@currentUser.Id"
                   class="flex items-center gap-2.5 px-3 py-2 rounded-lg text-sm font-medium text-sidebar-foreground hover:bg-sidebar-accent transition-all">

                <div class="w-6 h-6 rounded-full overflow-hidden bg-primary flex items-center justify-center">
                    @if (!string.IsNullOrEmpty(currentUser.AvatarUrl))
                    {
                        <img src="@currentUser.AvatarUrl"
                             alt="@currentUser.Name"
                             class="w-full h-full object-cover" />
                    }
                    else
                    {
                        <span class="text-primary-foreground text-xs font-bold">
                            @currentUser.Name.FirstOrDefault().ToString().ToUpper()
                        </span>
                    }
                </div>

                <span class="truncate">
                    @currentUser.Name
                </span>

            </a>
        }
        else
        {
            <a asp-controller="Auth"
                   asp-action="Login"
                   class="flex items-center gap-2.5 px-3 py-2 rounded-lg text-sm font-medium text-sidebar-foreground hover:bg-sidebar-accent transition-all">

                <i data-lucide="log-in"
                       class="w-4 h-4">
                </i>

                <span>Sign in</span>

            </a>
        }

    </div>

</aside>

<div id="sidebarOverlay"
     class="fixed inset-0 bg-black/40 z-40 md:hidden hidden">
</div>