@model Tasky.Models.TaskItem
@{
    var statuses = new[] { "todo", "in_progress", "done", "cancelled" };
    var currentIdx = Array.IndexOf(statuses, Model.Status ?? "todo");
    if (currentIdx < 0) currentIdx = 0;
    var nextStatus = statuses[(currentIdx + 1) % statuses.Length];

    string dueDateColor = "";
    if (Model.DueDate.HasValue)
    {
        if (Model.DueDate.Value.Date < DateTime.Now.Date && Model.Status != "done") dueDateColor = "text-red-500";
        else if (Model.DueDate.Value.Date == DateTime.Now.Date) dueDateColor = "text-orange-500";
        else dueDateColor = "text-muted-foreground";
    }

    string priorityColor = Model.Priority switch
    {
        "urgent" => "bg-red-100 text-red-700 border-red-200 dark:bg-red-900/40 dark:text-red-300 dark:border-red-800",
        "high" => "bg-orange-100 text-orange-700 border-orange-200 dark:bg-orange-900/40 dark:text-orange-300 dark:border-orange-800",
        "medium" => "bg-blue-100 text-blue-700 border-blue-200 dark:bg-blue-900/40 dark:text-blue-300 dark:border-blue-800",
        "low" => "bg-slate-100 text-slate-600 border-slate-200 dark:bg-slate-800 dark:text-slate-300 dark:border-slate-700",
        _ => "bg-blue-100 text-blue-700 border-blue-200 dark:bg-blue-900/40 dark:text-blue-300 dark:border-blue-800",
    };
    string priorityText = string.IsNullOrEmpty(Model.Priority) ? "Medium" : char.ToUpper(Model.Priority[0]) + Model.Priority.Substring(1);

    string statusColor = Model.Status switch
    {
        "in_progress" => "text-blue-500",
        "done" => "text-green-500",
        "cancelled" => "text-red-400",
        _ => "text-slate-400"
    };
    string statusIcon = Model.Status switch
    {
        "in_progress" => "clock",
        "done" => "check-circle-2",
        "cancelled" => "x-circle",
        _ => "circle"
    };
}

<div class="task-card bg-card border border-card-border rounded-lg p-3 shadow-sm hover:shadow-md hover:border-primary/20 transition-all group cursor-pointer"
     draggable="true"
     data-task-id="@Model.Id">
    <div class="flex items-start gap-2">
        <button class="status-toggle-btn mt-0.5 shrink-0 hover:scale-110 transition-transform" data-next-status="@nextStatus">
            <i data-lucide="@statusIcon" class="w-4 h-4 @statusColor"></i>
        </button>
        <div class="flex-1 min-w-0 task-drag-handle cursor-grab active:cursor-grabbing">
            <p class="text-sm font-medium leading-snug @(Model.Status == "done" ? "line-through text-muted-foreground" : "text-card-foreground")">
                @(string.IsNullOrEmpty(Model.Title) ? Html.Raw("<span class='italic text-muted-foreground'>Untitled</span>") : Model.Title)
            </p>
            @if (!string.IsNullOrEmpty(Model.Description))
            {
                <p class="text-xs text-muted-foreground mt-1 line-clamp-2">@Model.Description</p>
            }
            <div class="flex items-center flex-wrap gap-1.5 mt-2">
                <span class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded text-[10px] font-semibold uppercase tracking-wider border @priorityColor">
                    @priorityText
                </span>
                @if (Model.DueDate.HasValue)
                {
                    <span class="inline-flex items-center gap-0.5 text-xs @dueDateColor">
                        <i data-lucide="calendar" class="w-3 h-3"></i>
                        @Model.DueDate.Value.ToString("MMM d")
                    </span>
                }
                <div class="ml-auto flex -space-x-2">
                    @if (Model.Assignees != null)
                    {
                        foreach (var assignee in Model.Assignees.Take(3))
                        {
                            <div class="w-5 h-5 rounded-full border-2 border-card bg-primary text-primary-foreground flex items-center justify-center text-[10px] font-bold z-10 relative overflow-hidden">
                                @assignee.User?.UserName?.Substring(0, 1).ToUpper()
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    </div>
</div>