@model IEnumerable<Tasky.Models.TaskList>
@{
    ViewData["Title"] = "Lists";
    
    var standaloneLists = Model?.Where(l => l.BoardId == null).OrderBy(l => l.Position).ToList() ?? new List<Tasky.Models.TaskList>();

    string GetStatusIcon(string status) => status switch { "in_progress" => "clock", "done" => "check-circle-2", "cancelled" => "x-circle", _ => "circle" };
    string GetStatusColor(string status) => status switch { "in_progress" => "text-blue-500", "done" => "text-green-500", "cancelled" => "text-red-400", _ => "text-slate-400" };
    string GetPriorityColor(string priority) => priority switch
    {
        "urgent" => "bg-red-100 text-red-700 border-red-200 dark:bg-red-900/40 dark:text-red-300 dark:border-red-800",
        "high" => "bg-orange-100 text-orange-700 border-orange-200 dark:bg-orange-900/40 dark:text-orange-300 dark:border-orange-800",
        "medium" => "bg-blue-100 text-blue-700 border-blue-200 dark:bg-blue-900/40 dark:text-blue-300 dark:border-blue-800",
        "low" => "bg-slate-100 text-slate-600 border-slate-200 dark:bg-slate-800 dark:text-slate-300 dark:border-slate-700",
        _ => "bg-blue-100 text-blue-700 border-blue-200 dark:bg-blue-900/40 dark:text-blue-300 dark:border-blue-800",
    };
    string FormatPriority(string priority) => string.IsNullOrEmpty(priority) ? "Medium" : char.ToUpper(priority[0]) + priority.Substring(1);
}

<div class="flex flex-col h-[calc(100vh-64px)]">
    <div class="px-6 py-4 border-b border-border bg-background/80 backdrop-blur-sm shrink-0">
        <div class="flex items-center justify-between gap-4">
            <div>
                <h1 class="text-xl font-bold text-foreground">Lists</h1>
                <p class="text-xs text-muted-foreground mt-0.5">Standalone checklists and to-dos</p>
            </div>
            <div class="flex items-center gap-3">
                <div class="relative">
                    <i data-lucide="search" class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-muted-foreground"></i>
                    <input id="searchInput" type="text" placeholder="Search lists..."
                           class="pl-9 pr-4 py-1.5 text-sm border border-input rounded-lg bg-background text-foreground outline-none focus:ring-2 ring-ring w-52 transition-all" />
                </div>
                <button id="showCreateListBtn" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-primary text-primary-foreground text-sm font-medium hover:opacity-90 transition-opacity">
                    <i data-lucide="plus" class="w-3.5 h-3.5"></i>
                    New List
                </button>
            </div>
        </div>
    </div>

    <div class="flex-1 overflow-y-auto">
        <div id="listsContainer" class=" grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 p-6 items-start">
            
            @foreach (var list in standaloneLists)
            {
                <div class="standalone-list w-full bg-muted/50 rounded-xl flex flex-col max-h-[calc(100vh-13rem)] overflow-hidden"
                     data-list-id="@list.Id" data-list-title="@list.Title?.ToLower()">
                    
                    <div class="flex items-center gap-1 px-2 py-3 border-b border-border/60 shrink-0">
                        <div class="list-drag-handle cursor-grab active:cursor-grabbing p-1 rounded hover:bg-muted text-muted-foreground shrink-0 touch-none">
                            <i data-lucide="grip-vertical" class="w-3.5 h-3.5"></i>
                        </div>
                        <button class="list-title-display flex-1 text-sm font-semibold text-foreground text-left truncate">
                            @(string.IsNullOrEmpty(list.Title) ? "Untitled List" : list.Title)
                        </button>
                        <input type="text" class="list-title-input hidden flex-1 text-sm font-semibold bg-transparent border-b border-primary outline-none text-foreground" value="@list.Title" />
                        
                        <div class="flex items-center gap-1.5 shrink-0">
                            <span class="text-xs text-muted-foreground">@(list.Tasks?.Count ?? 0)</span>
                            <button class="delete-list-btn p-0.5 rounded hover:bg-destructive/10 text-muted-foreground hover:text-destructive transition-all">
                                <i data-lucide="trash-2" class="w-3.5 h-3.5"></i>
                            </button>
                        </div>
                    </div>

                    <div class="tasks-area flex-1 overflow-y-auto min-h-[60px] transition-colors">
                        <div class="divide-y divide-border">
                            @if (list.Tasks != null)
                            {
                                foreach (var task in list.Tasks)
                                {
                                    <div class="task-row flex items-center gap-3 px-4 py-2.5 hover:bg-muted/30 transition-colors group cursor-grab active:cursor-grabbing"
                                         data-task-id="@task.Id" data-task-title="@task.Title?.ToLower()">
                                        
                                        <button class="status-toggle-btn shrink-0 hover:scale-110 transition-transform cursor-pointer" data-status="@task.Status">
                                            <i data-lucide="@GetStatusIcon(task.Status)" class="w-4 h-4 @GetStatusColor(task.Status)"></i>
                                        </button>
                                        
                                        <span class="flex-1 text-sm text-foreground min-w-0 truncate @(task.Status == "done" ? "line-through text-muted-foreground" : "")">
                                            @task.Title
                                        </span>

                                        <div class="flex items-center gap-2 shrink-0">
                                            <span class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded text-[10px] font-semibold uppercase tracking-wider border @GetPriorityColor(task.Priority)">
                                                @FormatPriority(task.Priority)
                                            </span>
                                            @if (task.DueDate.HasValue)
                                            {
                                                <span class="text-xs text-muted-foreground flex items-center gap-0.5">
                                                    <i data-lucide="calendar" class="w-3.5 h-3.5"></i>
                                                    @task.DueDate.Value.ToString("MMM d")
                                                </span>
                                            }
                                            <button class="delete-task-btn opacity-0 group-hover:opacity-100 transition-opacity p-1 rounded hover:bg-destructive/10">
                                                <i data-lucide="trash-2" class="w-3 h-3 text-muted-foreground hover:text-destructive"></i>
                                            </button>
                                        </div>
                                    </div>
                                }
                            }
                        </div>
                    </div>

                    <div class="shrink-0 border-t border-border/60">
                        <div class="inline-task-input hidden flex items-center gap-2 px-4 py-2 bg-muted/20">
                            <div class="w-4 h-4 rounded-full border-2 border-muted-foreground/30 shrink-0"></div>
                            <input type="text" placeholder="Item name..." class="new-task-input flex-1 text-sm bg-transparent outline-none text-foreground placeholder:text-muted-foreground" />
                            <button class="confirm-task-btn text-xs font-medium text-primary hover:underline">Add</button>
                            <button class="cancel-task-btn p-0.5 text-muted-foreground hover:text-foreground">
                                <i data-lucide="x" class="w-3.5 h-3.5"></i>
                            </button>
                        </div>
                        <div class="add-task-trigger px-4 py-2">
                            <button class="flex items-center gap-1.5 text-sm text-muted-foreground hover:text-primary transition-colors py-1">
                                <i data-lucide="plus" class="w-3.5 h-3.5"></i> Add item
                            </button>
                        </div>
                    </div>
                </div>
            }

            <div id="createListCard" class="hidden w-full bg-card border border-primary/30 rounded-xl p-4 h-fit">
                <input id="newListInput" type="text" placeholder="List name..." class="w-full text-sm font-semibold bg-transparent border-b border-primary outline-none text-foreground mb-3" />
                <div class="flex gap-2">
                    <button id="confirmCreateList" class="px-3 py-1.5 text-xs font-medium bg-primary text-primary-foreground rounded-lg hover:opacity-90">Create List</button>
                    <button id="cancelCreateList" class="px-3 py-1.5 text-xs text-muted-foreground hover:text-foreground rounded-lg hover:bg-muted">Cancel</button>
                </div>
            </div>

            <button id="triggerAddListCard" class="w-full h-16 border-2 border-dashed border-border rounded-xl flex items-center justify-center gap-2 text-sm text-muted-foreground hover:border-primary hover:text-primary transition-all">
                <i data-lucide="plus" class="w-4 h-4"></i> Create list
            </button>
        </div>

        <div id="emptySearchState" class="hidden flex-col items-center justify-center h-full py-20 text-center">
            <div class="w-12 h-12 rounded-xl bg-muted flex items-center justify-center mb-4">
                <i data-lucide="search" class="w-6 h-6 text-muted-foreground"></i>
            </div>
            <h3 class="text-base font-semibold text-foreground mb-1">No lists match your search</h3>
            <p class="text-sm text-muted-foreground">Try a different search term</p>
        </div>
    </div>
</div>

<div id="deleteConfirmModal" class="fixed inset-0 bg-black/40 z-50 hidden items-center justify-center p-4">
    <div class="bg-background border border-border rounded-xl shadow-2xl w-full max-w-sm overflow-hidden">
        <div class="p-5">
            <h3 id="deleteModalTitle"
                class="text-lg font-bold text-foreground mb-2">
                Delete list?
            </h3>

            <p id="deleteModalDescription"
                   class="text-sm text-muted-foreground">
                This action cannot be undone. The list will be permanently removed.
            </p>
        </div>

        <div class="p-4 bg-muted/50 border-t border-border flex justify-end gap-2">
            <button id="cancelDeleteBtn"
                    class="px-4 py-2 rounded-lg text-sm font-medium border border-border bg-background text-muted-foreground hover:text-foreground transition-colors">
                Cancel
            </button>

            <button id="confirmDeleteBtn"
                    class="px-4 py-2 rounded-lg text-sm font-medium bg-destructive text-destructive-foreground hover:opacity-90 transition-opacity">
                Delete
            </button>
        </div>
    </div>
</div>

<partial name="_TaskDetailsPanel" model="null" />

@section Scripts {
    <script src="~/js/lists.js" asp-append-version="true"></script>
    <script src="~/js/task-panel.js" asp-append-version="true"></script>
}