@model IEnumerable<Tasky.Models.Board>
@{
    ViewData["Title"] = "Boards";
    var boards = Model?.ToList() ?? new();
}

<div class="p-4 sm:p-6 max-w-7xl mx-auto space-y-6">
    <div class="flex items-center justify-between">
        <div>
            <h1 class="text-2xl font-bold text-foreground">Boards</h1>
            <p class="text-sm text-muted-foreground mt-0.5" id="boardsCount">
                @boards.Count board@(boards.Count != 1 ? "s" : "")
            </p>
        </div>
        <button id="openCreateBoard" class="inline-flex items-center gap-1.5 px-3 py-2 rounded-lg bg-primary text-primary-foreground text-sm font-medium hover:opacity-90 transition-opacity">
            <i data-lucide="plus" class="w-3.5 h-3.5"></i>
            New Board
        </button>
    </div>

    <div class="relative">
        <i data-lucide="search" class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-muted-foreground"></i>
        <input id="boardSearch" type="text" placeholder="Search boards..." class="w-full pl-9 pr-4 py-2 text-sm border border-input rounded-lg bg-background text-foreground outline-none focus:ring-2 ring-ring" />
    </div>

    <div class="flex gap-1 overflow-x-auto pb-1">
        <button class="board-filter bg-primary text-primary-foreground px-3 py-1.5 rounded-lg text-sm font-medium whitespace-nowrap transition-all" data-filter="all">All</button>
        <button class="board-filter text-muted-foreground hover:bg-muted hover:text-foreground px-3 py-1.5 rounded-lg text-sm font-medium whitespace-nowrap transition-all" data-filter="personal">Personal</button>
        @if (User.Identity?.IsAuthenticated == true)
        {
            <button class="board-filter text-muted-foreground hover:bg-muted hover:text-foreground px-3 py-1.5 rounded-lg text-sm font-medium whitespace-nowrap transition-all" data-filter="collective">Collective</button>
        }
        else
        {
            <button class="board-filter opacity-50 cursor-not-allowed text-muted-foreground px-3 py-1.5 rounded-lg text-sm font-medium whitespace-nowrap flex items-center gap-1.5" data-filter="collective" title="Sign in to view collective boards">
                <i data-lucide="lock" class="w-3 h-3"></i> Collective
            </button>
        }
    </div>

    <div id="emptyStateContainer" class="@(boards.Any() ? "hidden" : "flex") flex-col items-center justify-center py-20 text-center">
        <div class="w-12 h-12 rounded-xl bg-muted flex items-center justify-center mb-4">
            <i data-lucide="layers" class="w-6 h-6 text-muted-foreground"></i>
        </div>
        <h3 id="emptyStateTitle" class="text-base font-semibold text-foreground mb-1">No boards yet</h3>
        <p id="emptyStateDesc" class="text-sm text-muted-foreground mb-4">Create your first board to get started</p>
        <button id="emptyCreateBoard" class="@(boards.Any() ? "hidden" : "inline-flex") items-center gap-1.5 px-3 py-2 rounded-lg bg-primary text-primary-foreground text-sm font-medium">
            <i data-lucide="plus" class="w-3.5 h-3.5"></i>
            Create Board
        </button>
    </div>

    <div id="boardsGrid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 @(!boards.Any() ? "hidden" : "")">
        @foreach (var board in boards)
        {
            <div class="board-item" data-id="@board.Id" data-title="@board.Title?.ToLower()" data-description="@board.Description?.ToLower()" data-type="@(board.IsCollective ? "collective" : "personal")">
                <a asp-controller="Boards" asp-action="Details" asp-route-id="@board.Id" class="block bg-card border border-card-border rounded-xl overflow-hidden hover:shadow-md hover:border-primary/30 transition-all cursor-pointer group">
                    <div class="h-16 relative" style="background-color:@(string.IsNullOrWhiteSpace(board.Color) ? "#6366f1" : board.Color)">
                        <div class="absolute top-2 right-2 flex gap-1">
                            <div class="absolute top-1 left-1 opacity-0 group-hover:opacity-100 transition-opacity">
                                <i data-lucide="grip-vertical" class="w-3.5 h-3.5 text-white/70"></i>
                            </div>
                            @if (board.IsCollective)
                            {
                                <span class="bg-white/20 text-white text-xs px-2 py-0.5 rounded-full flex items-center gap-1">
                                    <i data-lucide="users" class="w-3 h-3"></i> Collective
                                </span>
                            }
                        </div>
                    </div>
                    <div class="p-4">
                        <h3 class="font-semibold text-card-foreground group-hover:text-primary transition-colors truncate">@(string.IsNullOrWhiteSpace(board.Title) ? "Untitled" : board.Title)</h3>
                        @if (!string.IsNullOrWhiteSpace(board.Description))
                        {
                            <p class="text-sm text-muted-foreground mt-1 line-clamp-2">@board.Description</p>
                        }
                        <div class="flex items-center gap-3 mt-3 text-xs text-muted-foreground">
                            <span>@(board.Lists?.Sum(x => x.Tasks.Count) ?? 0) tasks</span>
                            @if (board.IsCollective)
                            {
                                <span class="flex items-center gap-1"><i data-lucide="users" class="w-3 h-3"></i> @(board.Members?.Count ?? 0) members</span>
                            }
                        </div>
                    </div>
                </a>
            </div>
        }
    </div>
</div>

<div id="createBoardModal" class="fixed inset-0 bg-black/40 z-50 hidden items-center justify-center p-4">
    <div id="createBoardModalContent" class="bg-background border border-border rounded-2xl shadow-2xl w-full max-w-md max-h-[90vh] overflow-y-auto">
        <div class="flex items-center justify-between px-5 py-4 border-b border-border sticky top-0 bg-background z-10">
            <h2 class="text-base font-semibold text-foreground">New Board</h2>
            <button id="closeCreateBoard" type="button" class="p-1.5 rounded-lg text-muted-foreground hover:text-foreground hover:bg-muted transition-all"><i data-lucide="x" class="w-4 h-4"></i></button>
        </div>

        <form asp-action="Create" method="post" class="p-5 space-y-4">
            @Html.AntiForgeryToken()
            <div id="boardPreview" class="h-20 rounded-xl flex items-end p-3 transition-all" style="background-color: #6366f1;">
                <span id="previewTitle" class="text-white/90 text-sm font-semibold drop-shadow">Board name</span>
            </div>

            <div>
                <label class="text-xs font-semibold text-muted-foreground uppercase tracking-wider block mb-1.5">Board Title</label>
                <input id="boardTitleInput" name="Title" required placeholder="e.g. Product Roadmap" class="w-full px-3 py-2 text-sm border border-input rounded-lg bg-background text-foreground outline-none focus:ring-2 ring-ring" />
            </div>

            <div>
                <label class="text-xs font-semibold text-muted-foreground uppercase tracking-wider block mb-1.5">Description (optional)</label>
                <input name="Description" placeholder="What's this board for?" class="w-full px-3 py-2 text-sm border border-input rounded-lg bg-background text-foreground outline-none focus:ring-2 ring-ring" />
            </div>

            <div>
                <label class="text-xs font-semibold text-muted-foreground uppercase tracking-wider block mb-1.5">Color</label>
                <div class="flex flex-wrap gap-2">
                    @{
                        var colors = new[] { "#6366f1", "#3b82f6", "#8b5cf6", "#10b981", "#f59e0b", "#ef4444", "#06b6d4", "#ec4899", "#84cc16", "#f97316" };
                    }
                    @foreach (var color in colors)
                    {
                        <button type="button" class="board-color flex items-center justify-center w-7 h-7 rounded-full border-2 transition-all hover:scale-110 outline-none" data-color="@color" style="background-color:@color; border-color: transparent;"></button>
                    }
                </div>
                <input type="hidden" id="boardColorInput" name="Color" value="#6366f1" />
            </div>

            <div>
                <label class="text-xs font-semibold text-muted-foreground uppercase tracking-wider block mb-1.5">Type</label>
                <div class="flex gap-2">
                    <button type="button" class="board-type flex-1 py-2 text-sm font-medium rounded-lg border transition-all bg-primary text-primary-foreground border-primary" data-type="personal">Personal</button>
                    <div class="flex-1 relative">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <button type="button" class="board-type w-full py-2 text-sm font-medium rounded-lg border transition-all bg-card text-muted-foreground border-card-border hover:border-primary/50 flex items-center justify-center gap-1.5" data-type="collective"><i data-lucide="users" class="w-3.5 h-3.5"></i> Collective</button>
                        }
                        else
                        {
                            <button type="button" disabled title="Sign in to create collective boards" class="w-full py-2 text-sm font-medium rounded-lg border border-card-border bg-card text-muted-foreground opacity-50 cursor-not-allowed flex items-center justify-center gap-1.5"><i data-lucide="lock" class="w-3.5 h-3.5"></i> Collective</button>
                        }
                    </div>
                </div>
                <input type="hidden" id="boardTypeInput" name="IsCollective" value="false" />
            </div>

            <div class="flex gap-2 pt-1">
                <button type="button" id="cancelCreateBoard" class="flex-1 py-2 text-sm font-medium rounded-lg border border-border text-muted-foreground hover:text-foreground hover:bg-muted transition-all">Cancel</button>
                <button type="submit" id="submitCreateBoard" disabled class="flex-1 py-2 text-sm font-medium rounded-lg bg-primary text-primary-foreground hover:opacity-90 transition-opacity disabled:opacity-50 disabled:cursor-not-allowed">Create Board</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script src="~/js/boards.js"></script>
}