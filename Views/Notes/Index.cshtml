@model IEnumerable<Tasky.Models.Note>
@{
    ViewData["Title"] = "Notes";
    
    var notes = Model?.ToList() ?? new List<Tasky.Models.Note>();
    
    var NOTE_COLORS = new[] {
        "#6366f133", "#3b82f633", "#8b5cf633", "#10b98133", "#f59e0b33", "#ef444433", "#06b6d433", "#ec489933", "#84cc1633", "#f9731633"
    };

    var pinnedNotes = notes.Where(n => n.IsPinned).ToList();
    var unpinnedNotes = notes.Where(n => !n.IsPinned).ToList();
}

<div class="p-4 sm:p-6 w-full space-y-6">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
        <div>
            <h1 class="text-2xl font-bold text-foreground">Notes</h1>
            <p class="text-sm text-muted-foreground mt-0.5">@notes.Count note@(notes.Count != 1 ? "s" : "")</p>
        </div>
        <div class="flex items-center gap-2 sm:gap-3">
            <div class="relative flex items-center w-full sm:w-auto">
                <i data-lucide="search" class="w-4 h-4 absolute left-3 text-muted-foreground pointer-events-none"></i>
                <input id="noteSearchInput" type="search" placeholder="Search notes..." class="pl-9 pr-3 py-1.5 text-sm border border-input rounded-lg bg-background text-foreground outline-none focus:ring-2 ring-ring w-full sm:w-56 transition-all" />
            </div>
            <button id="createNoteBtn" class="inline-flex items-center gap-1.5 px-3 py-2 rounded-lg bg-primary text-primary-foreground text-sm font-medium hover:opacity-90 transition-opacity whitespace-nowrap">
                <i data-lucide="plus" class="w-3.5 h-3.5"></i>
                New Note
            </button>
        </div>
    </div>

    <div id="emptyNotesState" class="@(notes.Any() ? "hidden" : "flex") flex-col items-center justify-center py-20 text-center">
        <div class="w-12 h-12 rounded-xl bg-muted flex items-center justify-center mb-4">
            <i data-lucide="sticky-note" class="w-6 h-6 text-muted-foreground"></i>
        </div>
        <h3 class="text-base font-semibold text-foreground mb-1">No notes yet</h3>
        <p class="text-sm text-muted-foreground mb-4">Click the button above to create your first note</p>
        <button id="emptyStateCreateBtn" class="inline-flex items-center gap-1.5 px-3 py-2 rounded-lg bg-primary text-primary-foreground text-sm font-medium">
            <i data-lucide="plus" class="w-3.5 h-3.5"></i>
            New Note
        </button>
    </div>

    <div id="notesContainer" class="@(!notes.Any() ? "hidden" : "space-y-6")">
        
        @if (pinnedNotes.Any())
        {
            <div class="note-group" data-group="pinned">
                @if (pinnedNotes.Any() && unpinnedNotes.Any())
                {
                    <p class="text-xs font-semibold text-muted-foreground uppercase tracking-wider mb-3 group-label">Pinned</p>
                }
                <div class="grid grid-cols-1 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6 2xl:grid-cols-7 gap-4 drop-zone">
                    @foreach (var note in pinnedNotes)
                    {
                        <partial name="_NoteCard" model="note" view-data='new ViewDataDictionary(ViewData) { { "Colors", NOTE_COLORS } }' />
                    }
                </div>
            </div>
        }

        @if (unpinnedNotes.Any())
        {
            <div class="note-group" data-group="others">
                @if (pinnedNotes.Any() && unpinnedNotes.Any())
                {
                    <p class="text-xs font-semibold text-muted-foreground uppercase tracking-wider mb-3 group-label">Others</p>
                }
                <div class="grid grid-cols-1 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6 2xl:grid-cols-7 gap-4 drop-zone">
                    @foreach (var note in unpinnedNotes)
                    {
                        <partial name="_NoteCard" model="note" view-data='new ViewDataDictionary(ViewData) { { "Colors", NOTE_COLORS } }' />
                    }
                </div>
            </div>
        }
    </div>
</div>

<div id="deleteConfirmModal" class="fixed inset-0 bg-black/40 z-50 hidden items-center justify-center p-4">
    <div class="bg-background border border-border rounded-xl shadow-2xl w-full max-w-sm overflow-hidden">
        <div class="p-5">
            <h3 class="text-lg font-bold text-foreground mb-2">Delete note?</h3>
            <p class="text-sm text-muted-foreground">This action cannot be undone. The note will be permanently removed.</p>
        </div>
        <div class="p-4 bg-muted/50 border-t border-border flex justify-end gap-2">
            <button id="cancelDeleteBtn" class="px-4 py-2 rounded-lg text-sm font-medium border border-border bg-background text-muted-foreground hover:text-foreground transition-colors">Cancel</button>
            <button id="confirmDeleteBtn" class="px-4 py-2 rounded-lg text-sm font-medium bg-destructive text-destructive-foreground hover:opacity-90 transition-opacity">Delete note</button>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/notes.js" asp-append-version="true"></script>
}