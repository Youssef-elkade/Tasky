@model Tasky.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    
    var totalStatusCount = Model.TasksByStatus.Values.Sum();
    if (totalStatusCount == 0) totalStatusCount = 1;

    string GetStatusIcon(string? status) => status switch { "in_progress" => "clock", "done" => "check-circle-2", "cancelled" => "x-circle", _ => "circle" };
    string GetStatusColor(string? status) => status switch { "todo" => "text-slate-400", "in_progress" => "text-blue-500", "done" => "text-green-500", "cancelled" => "text-red-400", _ => "text-slate-400" };
    string GetPriorityColor(string priority) => priority switch
    {
        "urgent" => "bg-red-100 text-red-700 border-red-200 dark:bg-red-900/40 dark:text-red-300 dark:border-red-800",
        "high" => "bg-orange-100 text-orange-700 border-orange-200 dark:bg-orange-900/40 dark:text-orange-300 dark:border-orange-800",
        "medium" => "bg-blue-100 text-blue-700 border-blue-200 dark:bg-blue-900/40 dark:text-blue-300 dark:border-blue-800",
        "low" => "bg-slate-100 text-slate-600 border-slate-200 dark:bg-slate-800 dark:text-slate-300 dark:border-slate-700",
        _ => "bg-blue-100 text-blue-700 border-blue-200 dark:bg-blue-900/40 dark:text-blue-300 dark:border-blue-800",
    }; 
    string FormatPriority(string? priority) => string.IsNullOrEmpty(priority) ? "Medium" : char.ToUpper(priority[0]) + priority.Substring(1);
}

<div class="p-4 sm:p-6 max-w-7xl mx-auto space-y-6">
    
    <div class="flex items-center justify-between">
        <div>
            <h1 class="text-2xl font-bold text-foreground">Dashboard</h1>
            <p class="text-sm text-muted-foreground mt-0.5">Your workspace at a glance</p>
        </div>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-3 xl:grid-cols-6 gap-3 sm:gap-4">
        <div class="bg-card border border-card-border rounded-xl p-5 flex items-center gap-4">
            <div class="w-10 h-10 rounded-lg flex items-center justify-center bg-primary">
                <i data-lucide="square-kanban" class="w-5 h-5 text-white"></i>
            </div>
            <div>
                <div class="text-2xl font-bold text-card-foreground">@Model.TotalBoards</div>
                <div class="text-sm text-muted-foreground">Boards</div>
            </div>
        </div>
        
        <div class="bg-card border border-card-border rounded-xl p-5 flex items-center gap-4">
            <div class="w-10 h-10 rounded-lg flex items-center justify-center bg-blue-500">
                <i data-lucide="check-square" class="w-5 h-5 text-white"></i>
            </div>
            <div>
                <div class="text-2xl font-bold text-card-foreground">@Model.TotalTasks</div>
                <div class="text-sm text-muted-foreground">Total Tasks</div>
            </div>
        </div>
        
        <div class="bg-card border border-card-border rounded-xl p-5 flex items-center gap-4">
            <div class="w-10 h-10 rounded-lg flex items-center justify-center bg-green-500">
                <i data-lucide="check-square" class="w-5 h-5 text-white"></i>
            </div>
            <div>
                <div class="text-2xl font-bold text-card-foreground">@Model.CompletedTasks</div>
                <div class="text-sm text-muted-foreground">Completed</div>
            </div>
        </div>
        
        <div class="bg-card border border-card-border rounded-xl p-5 flex items-center gap-4">
            <div class="w-10 h-10 rounded-lg flex items-center justify-center bg-red-500">
                <i data-lucide="alert-circle" class="w-5 h-5 text-white"></i>
            </div>
            <div>
                <div class="text-2xl font-bold text-card-foreground">@Model.OverdueTasks</div>
                <div class="text-sm text-muted-foreground">Overdue</div>
            </div>
        </div>
        
        <div class="bg-card border border-card-border rounded-xl p-5 flex items-center gap-4">
            <div class="w-10 h-10 rounded-lg flex items-center justify-center bg-purple-500">
                <i data-lucide="list" class="w-5 h-5 text-white"></i>
            </div>
            <div>
                <div class="text-2xl font-bold text-card-foreground">@Model.ActiveLists</div>
                <div class="text-sm text-muted-foreground">Lists</div>
            </div>
        </div>
        
        <div class="bg-card border border-card-border rounded-xl p-5 flex items-center gap-4">
            <div class="w-10 h-10 rounded-lg flex items-center justify-center bg-amber-500">
                <i data-lucide="sticky-note" class="w-5 h-5 text-white"></i>
            </div>
            <div>
                <div class="text-2xl font-bold text-card-foreground">@Model.TotalNotes</div>
                <div class="text-sm text-muted-foreground">Notes</div>
            </div>
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <div class="bg-card border border-card-border rounded-xl p-5">
            <h2 class="text-base font-semibold text-card-foreground mb-4">Tasks by Status</h2>
            <div class="space-y-3">
                @if (Model.TasksByStatus.Any())
                {
                    foreach (var status in Model.TasksByStatus)
                    {
                        var percentage = ((double)status.Value / totalStatusCount) * 100;
                        <div class="flex items-center gap-3">
                            <i data-lucide="@GetStatusIcon(status.Key)" class="w-4 h-4 @GetStatusColor(status.Key)"></i>
                            <div class="flex-1">
                                <div class="flex justify-between text-sm mb-1">
                                    <span class="capitalize text-foreground">@status.Key.Replace("_", " ")</span>
                                    <span class="text-muted-foreground font-medium">@status.Value</span>
                                </div>
                                <div class="h-1.5 bg-muted rounded-full overflow-hidden">
                                    <div class="h-full bg-primary rounded-full transition-all" style="width: @percentage%"></div>
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="flex flex-col items-center justify-center py-8 text-center">
                        <i data-lucide="check-square" class="w-8 h-8 text-muted-foreground/40 mb-2"></i>
                        <p class="text-sm text-muted-foreground">No tasks yet — create one to get started</p>
                        <a href="/Tasks" class="mt-3 text-xs text-primary hover:underline">Go to Tasks</a>
                    </div>
                }
            </div>
        </div>

        <div class="bg-card border border-card-border rounded-xl p-5">
            <div class="flex items-center justify-between mb-4">
                <h2 class="text-base font-semibold text-card-foreground">
                    @(Model.UpcomingTasks.Any() ? "Due This Week" : "Recent Tasks")
                </h2>
            </div>
            <div class="space-y-2">
                @{
                    var displayTasks = Model.UpcomingTasks.Any() ? Model.UpcomingTasks : Model.RecentTasks;
                }
                
                @if (displayTasks.Any())
                {
                    foreach (var task in displayTasks)
                    {
                        var status = string.IsNullOrEmpty(task.Status) ? "todo" : task.Status;
                        var priority = string.IsNullOrEmpty(task.Priority) ? "medium" : task.Priority;
                        
                        <div class="flex items-center gap-3 py-1.5">
                            <i data-lucide="@GetStatusIcon(status)" class="w-4 h-4 @GetStatusColor(status) shrink-0"></i>
                            <div class="flex-1 min-w-0">
                                <p class="text-sm text-foreground truncate">@task.Title</p>
                                @if (task.List != null)
                                {
                                    <p class="text-xs text-muted-foreground truncate">
                                        @if (task.List.Board != null)
                                        {
                                            <span class="font-medium">@task.List.Board.Title</span>
                                            <span class="mx-1 opacity-50">›</span>
                                        }

                                        @task.List.Title
                                    </p>
                                }
                            </div>
                            <div class="flex items-center gap-1.5 shrink-0">
                                <span class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded text-[10px] font-semibold uppercase tracking-wider border @GetPriorityColor(priority)">
                                    @FormatPriority(priority)
                                </span>
                                @if (task.DueDate.HasValue)
                                {
                                    <span class="text-xs text-muted-foreground whitespace-nowrap">
                                        @task.DueDate.Value.ToString("MMM dd")
                                    </span>
                                }
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="flex flex-col items-center justify-center py-8 text-center">
                        <i data-lucide="check-square" class="w-8 h-8 text-muted-foreground/40 mb-2"></i>
                        <p class="text-sm text-muted-foreground">No tasks yet</p>
                        <a href="/Tasks" class="mt-3 text-xs text-primary hover:underline">Create a task</a>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-5 gap-3 sm:gap-4">
        <a href="/Boards" class="bg-card border border-card-border rounded-xl p-4 flex items-center gap-3 hover:border-primary/30 hover:shadow-sm transition-all cursor-pointer">
            <div class="w-8 h-8 rounded-lg flex items-center justify-center shrink-0 bg-primary/10 text-primary">
                <i data-lucide="square-kanban" class="w-4 h-4"></i>
            </div>
            <span class="text-sm font-medium text-foreground">View Boards</span>
        </a>

        <a href="/Lists" class="bg-card border border-card-border rounded-xl p-4 flex items-center gap-3 hover:border-primary/30 hover:shadow-sm transition-all cursor-pointer">
            <div class="w-8 h-8 rounded-lg flex items-center justify-center shrink-0 bg-red-500/10 text-red-400">
                <i data-lucide="list" class="w-4 h-4"></i>
            </div>
            <span class="text-sm font-medium text-foreground">View Lists</span>
        </a>
        
        <a href="/Tasks" class="bg-card border border-card-border rounded-xl p-4 flex items-center gap-3 hover:border-primary/30 hover:shadow-sm transition-all cursor-pointer">
            <div class="w-8 h-8 rounded-lg flex items-center justify-center shrink-0 bg-blue-500/10 text-blue-600 dark:text-blue-400">
                <i data-lucide="check-square" class="w-4 h-4"></i>
            </div>
            <span class="text-sm font-medium text-foreground">My Tasks</span>
        </a>
        
        <a href="/Notes" class="bg-card border border-card-border rounded-xl p-4 flex items-center gap-3 hover:border-primary/30 hover:shadow-sm transition-all cursor-pointer">
            <div class="w-8 h-8 rounded-lg flex items-center justify-center shrink-0 bg-amber-500/10 text-amber-600 dark:text-amber-400">
                <i data-lucide="sticky-note" class="w-4 h-4"></i>
            </div>
            <span class="text-sm font-medium text-foreground">Notes</span>
        </a>
        
        <a href="/Canvases" class="bg-card border border-card-border rounded-xl p-4 flex items-center gap-3 hover:border-primary/30 hover:shadow-sm transition-all cursor-pointer">
            <div class="w-8 h-8 rounded-lg flex items-center justify-center shrink-0 bg-purple-500/10 text-purple-600 dark:text-purple-400">
                <i data-lucide="book-open" class="w-4 h-4"></i>
            </div>
            <span class="text-sm font-medium text-foreground">Canvases</span>
        </a>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            if (window.lucide) {
                window.lucide.createIcons();
            }
        });
    </script>
}